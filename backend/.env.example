# Copy to `.env` and adjust. Never commit the real `.env`.
APP_NAME="AI Travel Planner API"
APP_VERSION=1.0.0
# One of: development, staging, production
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Google Gemini API (M2)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_RETRIES=1

# Geocoding & Distance Feasibility (M3)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="AITravelPlanner/1.0.0 (contact@aitravelplanner.local)"
NOMINATIM_MIN_INTERVAL_SECONDS=1.05
GEOCODING_TIMEOUT_SECONDS=10
# Optional fallback (Google Places API New)
GOOGLE_PLACES_API_KEY=
MAX_SAME_DAY_DISTANCE_KM=50.0
AVERAGE_TRAVEL_SPEED_KMH=40.0

# Weather Proxy (M3, Open-Meteo — no API key required)
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10

# Caching (M4): disk (local SQLite), redis (production), or memory
CACHE_BACKEND=disk
DISKCACHE_DIR=.cache/itineraries
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# Rate Limiting & API Key Auth (M4)
RATE_LIMIT_ITINERARY=5/day
RATE_LIMIT_REGENERATE_SLOT=20/day
# Use "memory://" for local dev or "redis://localhost:6379/1" for production
RATE_LIMIT_STORAGE_URI=memory://
# Leave blank to disable API key auth in local dev; set a strong secret in prod
API_KEY=
